# Copy to .env.local for local development. Every variable is optional:
# with none set, the site builds and renders the no-releases state.

# Supabase project URL (Project Settings -> API). Public; shipped to the browser.
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon key. Public; RLS limits it to published releases and tracks.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service-role key. Server-only: drop-alert inserts and preview reads.
# Never expose to the browser, never commit.
SUPABASE_SERVICE_ROLE_KEY=

# Shared secret for /music/<slug>?preview=<PREVIEW_SECRET> to view unpublished releases.
PREVIEW_SECRET=

# Shared secret checked in the x-revalidate-secret header on POST /api/revalidate.
REVALIDATE_SECRET=
